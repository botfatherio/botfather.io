---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import DocsSection from "../../../components/DocsSection.astro";
import DocsItem from "../../../components/DocsItem.astro";

const guides = await getCollection("guides");
---

<Layout title="Guides">
  <Header
    title="Guides"
    description="Step-by-step tutorials to get you started on creating your own bots."
  />

  <div class="container my-5">
    <DocsSection href="/docs/guides/" title="Guides">
      {
        guides.map((guide) => (
          <DocsItem
            href={`/docs/guides/${guide.id}/`}
            title={guide.data.title}
          />
        ))
      }
    </DocsSection>
  </div>
</Layout>
