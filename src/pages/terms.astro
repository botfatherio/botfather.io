---
import { getEntry, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import LegalText from "@components/LegalText.astro";

const terms = await getEntry("legal", "terms")!;
const { Content } = await render(terms);
---

<Layout title={terms.data.title} divider>
  <LegalText title={terms.data.title}>
    <Content />
  </LegalText>
</Layout>
