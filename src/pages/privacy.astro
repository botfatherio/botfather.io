---
import { getEntry, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import LegalText from "@components/LegalText.astro";

const privacy = await getEntry("legal", "privacy")!;
const { Content } = await render(privacy);
---

<Layout title={privacy.data.title} divider>
  <LegalText title={privacy.data.title}>
    <Content />
  </LegalText>
</Layout>
